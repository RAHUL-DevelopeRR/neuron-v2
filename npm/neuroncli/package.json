{
  "name": "@zero-x.live/neuron",
  "version": "7.0.0-alpha.2",
  "description": "Neuron: an AI coding agent CLI for your terminal. Reads your project, edits files and runs commands with your permission, using the Zero-X gateway or your own model key.",
  "keywords": [
    "neuron",
    "neuron-agent",
    "neuron-cli",
    "neuroncli",
    "ai",
    "ai-agent",
    "coding-agent",
    "code-assistant",
    "ai-coding",
    "llm",
    "agentic",
    "cli",
    "terminal",
    "tui",
    "developer-tools",
    "zero-x",
    "zero-x.live"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "neuron": "bin/neuron.js"
  },
  "files": [
    "bin/neuron.js",
    "lib/",
    "scripts/install.js",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "postinstall": "node scripts/install.js",
    "test": "node --test \"test/*.test.js\""
  },
  "engines": {
    "node": ">=22.14"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "dependencies": {
    "codebase-memory-mcp": "0.11.0",
    "@playwright/mcp": "0.0.83"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RAHUL-DevelopeRR/neuron-v2.git"
  },
  "homepage": "https://github.com/RAHUL-DevelopeRR/neuron-v2#readme",
  "bugs": {
    "url": "https://github.com/RAHUL-DevelopeRR/neuron-v2/issues"
  }
}
