<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="NeuronCLI"
    Manufacturer="zero-x.live"
    Version="$(var.Version)"
    UpgradeCode="{A774006C-5B5A-4F8E-9D39-14C8E4175B56}"
    Scope="perMachine">
    <MajorUpgrade DowngradeErrorMessage="A newer version of NeuronCLI is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Feature Id="MainFeature" Title="NeuronCLI" Level="1">
      <ComponentGroupRef Id="NeuronComponents" />
    </Feature>
  </Package>

  <Fragment>
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="NeuronCLI" />
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="NeuronComponents" Directory="INSTALLFOLDER">
      <Component Id="NeuronExe" Guid="{5D1390AE-3E2C-44B7-8C29-F230045F6306}">
        <File Id="NeuronExeFile" Source="$(var.BinaryPath)" Name="neuron.exe" KeyPath="yes" />
        <Environment
          Id="NeuronPath"
          Name="PATH"
          Value="[INSTALLFOLDER]"
          Permanent="no"
          Part="last"
          Action="set"
          System="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
