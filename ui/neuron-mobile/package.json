{
  "name": "neuron-mobile",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "description": "Neuron Mobile: watch and steer a Neuron session running on your computer",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "relay": "bun run dev/relay.ts",
    "share": "bun run dev/share.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p ."
  },
  "packageManager": "bun@1.3.14",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "expo": "58.0.17",
    "expo-camera": "~58.0.12",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-device": "~58.0.5",
    "expo-linking": "~58.0.14",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.25",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "qrcode": "1.5.4",
    "typescript": "5.9.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
