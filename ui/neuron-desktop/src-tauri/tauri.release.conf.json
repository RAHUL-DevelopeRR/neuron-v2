{
  "$schema": "https://schema.tauri.app/config/2",
  "mainBinaryName": "neuron-desktop",
  "bundle": {
    "externalBin": ["target/sidecar/neuron"],
    "publisher": "Zero-X",
    "homepage": "https://zero-x.live",
    "copyright": "Copyright (c) 2026 RAHUL S / Zero-X",
    "category": "DeveloperTool",
    "shortDescription": "Neuron, the Zero-X coding agent",
    "longDescription": "Neuron Desktop: chat, tool cards, diffs, files and a terminal on the Neuron engine, which ships inside the app.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "hardenedRuntime": true
    },
    "linux": {
      "deb": {
        "section": "devel"
      }
    }
  }
}
