{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["bun", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "@neuron/client": ["../neuron-client/src/index.ts"]
    }
  },
  "include": ["src", "test", "scripts", "vite.config.ts"]
}
