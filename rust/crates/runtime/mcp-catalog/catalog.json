      ],
      "tools": {
        "get_available_services": "read",
        "read_documentation": "read",
        "read_sections": "read",
        "recommend": "read",
        "search_documentation": "read",
        "search_table": "read"
      },
      "default_tier": "external",
      "sandbox": {
        "network": ["docs.aws.amazon.com", "proxy.search.docs.aws.amazon.com", "pypi.org", "files.pythonhosted.org"]
      },
      "default_scope": "user"
    }
