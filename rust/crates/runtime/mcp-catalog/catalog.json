      },
      "tools": {
        "detect_changes": "read",
        "index_repository": "write",
        "index_status": "read",
        "list_projects": "read",
        "query_graph": "read",
        "search_code": "read",
        "search_graph": "read",
        "trace_path": "read"
      },
      "default_tier": "write",
      "sandbox": {
        "fs_read": ["."],
        "network": ["registry.npmjs.org", "github.com"]
      },
      "default_scope": "user"
    },
    {
      "id": "supabase",
