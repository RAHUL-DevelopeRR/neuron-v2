    {
      "id": "aws-docs",
      "name": "AWS documentation",
      "description": "Search and read AWS documentation and get related pages.",
      "publisher": "AWS Labs",
      "official": true,
      "licence": "Apache-2.0",
      "source": "https://github.com/awslabs/mcp/tree/main/src/aws-documentation-mcp-server",
      "transport": "stdio",
      "install": {
        "kind": "uv",
        "package": "awslabs.aws-documentation-mcp-server",
        "version": "1.2.4",
        "integrity": "sha256:f9101573807df4b852201c108ea38bc02c6724d1e51e0de354a38e0779cee0b6",
        "env": {
          "FASTMCP_LOG_LEVEL": "ERROR"
        }
      },
      "env": [
        {
          "name": "AWS_DOCUMENTATION_PARTITION",
          "label": "AWS partition: aws, or aws-cn for the China documentation",
          "secret": false,
          "required": false,
          "default": "aws"
