        "delete_branch": "destructive",
        "deploy_edge_function": "destructive",
        "execute_sql": "destructive",
        "generate_typescript_types": "read",
        "get_advisors": "read",
        "get_cost": "read",
        "get_edge_function": "read",
        "get_logs": "read",
        "get_organization": "read",
        "get_project": "read",
        "get_project_url": "read",
        "get_publishable_keys": "read",
        "get_storage_config": "read",
        "list_branches": "read",
        "list_edge_functions": "read",
        "list_extensions": "read",
        "list_migrations": "read",
        "list_organizations": "read",
        "list_projects": "read",
        "list_storage_buckets": "read",
        "list_tables": "read",
        "merge_branch": "destructive",
        "pause_project": "destructive",
        "rebase_branch": "destructive",
        "reset_branch": "destructive",
        "restore_project": "destructive",
        "search_docs": "read",
        "update_storage_config": "destructive"
      },
      "default_tier": "external",
      "sandbox": {
        "network": ["mcp.supabase.com"]
      },
      "default_scope": "user"
    },
    {
      "id": "context7",
      "name": "Context7",
      "description": "Current documentation and code examples for libraries and frameworks.",
      "publisher": "Upstash",
      "official": true,
      "licence": "MIT",
      "source": "https://github.com/upstash/context7",
      "transport": "http",
      "install": {
        "kind": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "Authorization": "Bearer ${secret:CONTEXT7_API_KEY}"
        }
      },
      "env": [
        {
          "name": "CONTEXT7_API_KEY",
