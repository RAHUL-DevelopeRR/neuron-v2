{
  "name": "@zero-x/neuron",
  "version": "6.3.0",
  "description": "NeuronCLI - AI coding agent. Go runtime + terminal TUI. Powered by zero-x.live.",
  "private": false,
  "type": "module",
  "bin": {
    "neuron": "bin/cli.js"
  },
  "scripts": {
    "dev": "tsx ui/react-tui/src/index.tsx",
    "build:tui": "cd ui/react-tui && npx tsc -p tsconfig.json",
    "build": "npm run build:tui",
    "check": "cd ui/react-tui && npx tsc -p tsconfig.json --noEmit",
    "start": "node bin/cli.js",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "neuron",
    "neuroncli",
    "cli",
    "ai",
    "coding-agent",
    "terminal",
    "tui",
    "kimi",
    "deepseek",
    "azure",
    "openrouter"
  ],
  "author": "RAHUL-DevelopeRR <rahultech72216@gmail.com>",
  "license": "MIT",
  "homepage": "https://zero-x.live/neuroncli",
  "repository": {
    "type": "git",
    "url": "https://github.com/RAHUL-DevelopeRR/neuron-v2"
  },
  "dependencies": {
    "ink": "^5.1.0",
    "react": "^18.3.1"
  },
  "optionalDependencies": {
    "@zero-x/neuron-darwin-arm64": "6.3.0",
    "@zero-x/neuron-darwin-x64": "6.3.0",
    "@zero-x/neuron-linux-arm64": "6.3.0",
    "@zero-x/neuron-linux-x64": "6.3.0",
    "@zero-x/neuron-win32-x64": "6.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
